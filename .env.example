# Local Docker Compose configuration. Change all credentials outside local development.
POSTGRES_DB=quillqay_db
POSTGRES_USER=quillqay
POSTGRES_PASSWORD=quillqay_dev_password
POSTGRES_PORT=5433

MINIO_ROOT_USER=quillqay
MINIO_ROOT_PASSWORD=quillqay_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_CONTENT_BUCKET=quillqay-content
S3_ASSETS_BUCKET=quillqay-assets
S3_REQUEST_TIMEOUT_SECONDS=5

ADMIN_EMAIL=admin@quillqay.local
ADMIN_PASSWORD=change-this-development-password
ADMIN_DISPLAY_NAME=Quillqay Admin

ALLOWED_ORIGIN=http://localhost:3001
BACKEND_PORT=3000
SESSION_COOKIE_NAME=quillqay_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
DATABASE_MAX_CONNECTIONS=5
DOCUMENT_MAX_BYTES=1048576
DOCUMENT_MAX_BLOCKS=2000
RUST_LOG=qillqay_backend=debug,tower_http=debug
