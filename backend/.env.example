DATABASE_URL=postgres://quillqay:quillqay_dev_password@localhost:5433/quillqay_db
DATABASE_MAX_CONNECTIONS=5
BIND_ADDR=0.0.0.0:3000
ALLOWED_ORIGIN=http://localhost:3001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=quillqay
S3_SECRET_ACCESS_KEY=quillqay_dev_password
S3_CONTENT_BUCKET=quillqay-content
S3_ASSETS_BUCKET=quillqay-assets
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_SECONDS=5

SESSION_COOKIE_NAME=quillqay_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

DOCUMENT_MAX_BYTES=1048576
DOCUMENT_MAX_BLOCKS=2000

# Required only for: cargo run -- bootstrap-admin
ADMIN_EMAIL=admin@quillqay.local
ADMIN_PASSWORD=change-this-development-password
ADMIN_DISPLAY_NAME=Quillqay Admin
